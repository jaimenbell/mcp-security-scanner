__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
dist/
build/
.env
.env.*
!.env.example

# Internal strategy/outreach drafts -- never publish (public repo)
docs/GTM-MANAGED-WATCH.md
staged/scan-tier-outreach-DRAFT-*.md
docs/SAAS-TIER-SPEC.md

# Internal GTM/outreach staging - never publish
staged/

# Outreach prospect state (real names/emails from mcp-outreach-sweep) -- never publish
data/outreach_state.toml

# Ecosystem-scan v2 local artifacts + scratch + real target list.
# These carry third-party repo names/paths and PRIVATE disclosure notes --
# never tracked (the anonymized aggregate is promoted by operator decision,
# not by git). The .example config (placeholders only) IS tracked.
ecoscan-artifacts/
ecoscan-scratch/
ecoscan-targets.json

# Claude Code local session state -- never publish (public repo)
.claude/

# Test-run artifacts. CI emits junit.xml (`pytest --junitxml=junit.xml`, see
# .github/workflows/ci.yml) and check_readme_counts.py reads it back. The file
# embeds the runner's hostname and absolute local filesystem paths from skip
# reasons, so a stray `git add -A` after a local CI-equivalent run would publish
# both to this public repo. Scope: repo root only -- that is the only place the
# CI command writes it.
/junit.xml
